# ============================================================
# CodeCrate · VS Code 离线部署源 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# 对外端口（docker compose 端口映射）
APP_PORT=3000

# 数据目录在宿主机上的路径（映射到容器内 /data）
# 数据库、安装包、插件、图标与 Remote-SSH server 都保存在这里，升级容器不会丢失。
# 可以是相对路径（相对 docker-compose.yml）或绝对路径，例如 /srv/codecrate/data
DATA_DIR_HOST=./data

# 镜像名。使用官方推送的镜像时改成 ghcr.io/<owner>/<repo>:latest 后执行
# docker compose pull；保留默认值则使用本地构建的镜像。
IMAGE_NAME=codecrate:1.0.0

# 站点名称，显示在前台页头
SITE_NAME=CodeCrate 离线部署源

# 管理员用户名（首次启动创建；仅允许小写字母、数字、点、下划线和短横线）
ADMIN_USERNAME=admin

# 管理员初始密码（至少 10 位）
# 留空时首次启动会生成随机密码：见启动日志与 data/initial-admin-password
# 已有管理员时该变量不会覆盖现有密码，请使用 npm run reset-admin
ADMIN_PASSWORD=

# 对外访问地址（可选）。用于同源校验、文档与 VS Code 接入地址的兜底
# 例如：https://registry.corp.local
PUBLIC_ORIGIN=

# 额外允许的写请求来源（逗号分隔，可选）
# 反向代理端口/域名与 Host 不一致时，把浏览器地址填在这里，例如：
# ALLOWED_ORIGINS=http://localhost:5173,https://registry.corp.local
ALLOWED_ORIGINS=

# 反向代理层数。直接暴露时保持 false；Nginx/Caddy 一层代理时设为 1
TRUST_PROXY=false

# Cookie Secure 策略：auto / always / never
# HTTPS 反向代理场景建议 auto（需配合 TRUST_PROXY=1）
COOKIE_SECURE=auto

# 允许访问的内网数据源主机（逗号分隔，支持 *.example.com）
# 默认拒绝环回、私网与保留地址；仅在确实使用内网镜像或代理 fake-IP 时配置
# 内网镜像示例：mirror.corp.local,*.internal.example
# Clash/Surge fake-IP 示例：
# NETWORK_ALLOWED_PRIVATE_HOSTS=update.code.visualstudio.com,*.microsoft.com,*.visualstudio.com,*.vsassets.io,*.open-vsx.org,*.eclipsecontent.org
NETWORK_ALLOWED_PRIVATE_HOSTS=

# 并发缓存任务数（1-16）
CACHE_CONCURRENCY=3

# 访问日志保留天数（30/90/180；0 表示永久）
ACCESS_LOG_RETENTION_DAYS=90

# 日志级别：trace / debug / info / warn / error
LOG_LEVEL=info

# 容器时区
TZ=Asia/Shanghai

# 以下变量通常无需修改，Dockerfile 中已设置默认值：
# DATA_DIR=/data
# STORAGE_DIR=/data/files
# DB_PATH=/data/registry.db
# WEB_DIST=/app/web/dist
# PORT=3000
