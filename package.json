{
  "name": "codecrate",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "CodeCrate — air-gapped registry for VS Code installers, extensions and Remote-SSH servers",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck",
    "lint": "eslint .",
    "test": "npm --workspace server run test",
    "reset-admin": "npm --workspace server run reset-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "typescript-eslint": "^8.15.0"
  }
}
